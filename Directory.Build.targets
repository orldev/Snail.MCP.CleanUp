<Project>

    <!--
        Publishing a Snail MCP server into ~/.snail-mcp/<SnailMcpName>/<date>-<time>.<commit>/ and pointing `current`
        at it: docs/publishing.md. The same file in every server's repository; a server opts in with <SnailMcpName>.

            dotnet publish src/Server -c Release -r osx-arm64 -p:Install=true
    -->

    <PropertyGroup>
        <SnailMcpRoot Condition="'$(SnailMcpRoot)' == ''">$(HOME)/.snail-mcp</SnailMcpRoot>
        <SnailMcpKept Condition="'$(SnailMcpKept)' == ''">3</SnailMcpKept>
        <IsSnailMcpInstall Condition="'$(Install)' == 'true' and '$(SnailMcpName)' != ''">true</IsSnailMcpInstall>
        <!-- A native build copies its program into the folder after Publish too; the install has to come after that copy. -->
        <SnailMcpAfterPublish Condition="'$(PublishAot)' == 'true'">CopyNativeBinary;_CopyAotSymbols</SnailMcpAfterPublish>
    </PropertyGroup>

    <!-- Names the publication and publishes into its own folder; nothing is ever written over a publication. -->
    <Target Name="SnailMcpNamePublication" BeforeTargets="PrepareForPublish" Condition="'$(IsSnailMcpInstall)' == 'true'">
        <Exec Command="git rev-parse --short HEAD" WorkingDirectory="$(MSBuildProjectDirectory)" ConsoleToMSBuild="true" StandardOutputImportance="low">
            <Output TaskParameter="ConsoleOutput" PropertyName="SnailMcpCommit"/>
        </Exec>
        <Exec Command="git status --porcelain" WorkingDirectory="$(MSBuildProjectDirectory)" ConsoleToMSBuild="true" StandardOutputImportance="low">
            <Output TaskParameter="ConsoleOutput" PropertyName="SnailMcpChanges"/>
        </Exec>
        <PropertyGroup>
            <SnailMcpHome>$(SnailMcpRoot)/$(SnailMcpName)</SnailMcpHome>
            <SnailMcpPublication>$([System.DateTime]::Now.ToString('yyyy-MM-dd-HHmm')).$(SnailMcpCommit)</SnailMcpPublication>
            <SnailMcpPublication Condition="'$(SnailMcpChanges)' != ''">$(SnailMcpPublication)-dirty</SnailMcpPublication>
            <PublishDir>$(SnailMcpHome)/$(SnailMcpPublication)/</PublishDir>
        </PropertyGroup>
        <Error Condition="Exists('$(PublishDir)')" Text="$(PublishDir) already exists; a publication is never written over. Publish again in a minute."/>
        <Message Importance="high" Text="$(SnailMcpName) -> $(PublishDir)"/>
    </Target>

    <!-- Companions, warm-up, `current`, and the old publications. -->
    <Target Name="SnailMcpInstall" AfterTargets="Publish" DependsOnTargets="$(SnailMcpAfterPublish)" Condition="'$(IsSnailMcpInstall)' == 'true'">
        <MSBuild Projects="@(SnailMcpCompanion)"
                 Targets="Publish"
                 Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier);PublishDir=$(PublishDir)"
                 RemoveProperties="Install"/>

        <!-- macOS looks into a new binary the first time it runs: let it happen now, not when a session starts it. -->
        <Exec Condition="'$(PublishAot)' == 'true'"
              Command="&quot;$(PublishDir)$(AssemblyName)&quot; $(SnailMcpWarmUp) &lt; /dev/null &gt; /dev/null 2&gt;&amp;1"
              Timeout="60000"
              ContinueOnError="true"/>
        <Exec Condition="'$(PublishAot)' == 'true'"
              WorkingDirectory="$(PublishDir)"
              Command="find . -maxdepth 1 -type f -perm -u+x ! -name '*.dylib' ! -name '$(AssemblyName)' | while read companion%3B do &quot;%24companion&quot; &lt; /dev/null &gt; /dev/null 2&gt;&amp;1%3B done%3B true"
              Timeout="60000"
              ContinueOnError="true"/>

        <Exec Command="ln -sfn &quot;$(SnailMcpPublication)&quot; &quot;$(SnailMcpHome)/current&quot;"/>

        <!-- Keeps the newest $(SnailMcpKept), the one `current` names, and any a running process still uses. -->
        <Exec WorkingDirectory="$(SnailMcpHome)"
              Command="ls -1d 20*/ | sed 's#/##' | sort -r | tail -n +%24(( $(SnailMcpKept) + 1 )) | while read old%3B do [ &quot;%24old&quot; = &quot;%24(readlink current)&quot; ] &amp;&amp; continue%3B pgrep -f &quot;$(SnailMcpHome)/%24old/&quot; &gt; /dev/null &amp;&amp; continue%3B rm -rf &quot;%24old&quot; &amp;&amp; echo &quot;removed %24old&quot;%3B done"/>

        <Message Importance="high" Text="$(SnailMcpName): current -> $(SnailMcpPublication)"/>
    </Target>

</Project>
