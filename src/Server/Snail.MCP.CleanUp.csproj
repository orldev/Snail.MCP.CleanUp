<Project Sdk="Snail.Sdk.Mcp">

    <!--
        A native stdio server (Snail.Sdk.Mcp: SnailMcpNative and SnailMcpTransport at their defaults): published with
        Native AOT, settings bound by generated code, a dotnet tool of the McpServer kind, Install into ~/.s3l-mcp.
    -->
    <PropertyGroup>
        <!-- libproc and sysctl are called through LibraryImport, whose generated marshalling is unsafe code. -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>

    <!--
        The server is a native program wherever it is published for a runtime: 51 ms to start instead of 146, 56 MB
        resident instead of 136, a session-start hook 0.28 s instead of 0.57 (measured on 2026-10-12). Optimised for size:
        speed measured the same, since a census waits on the programs and the kernel it asks, and the binary is 1.4 MB
        smaller.
        As a dotnet tool it is a package per platform, each native, and a framework-dependent one for the rest
        (Snail.Sdk's docs/workflows.md): `dotnet pack` makes the package that points at them, `dotnet pack -r <rid>` each native one
        on its own system, `dotnet pack -r any -p:PublishAot=false` the fallback. Windows is not among them: the server
        reads the process table, sockets and changes the unix way.
    -->
    <PropertyGroup>
        <ToolPackageRuntimeIdentifiers>osx-arm64;osx-x64;linux-x64;linux-arm64;any</ToolPackageRuntimeIdentifiers>
    </PropertyGroup>

    <!--
        Feature switches measured on the native build and left as they are (2026-10-12): EventSourceSupport=false is
        already the native default — the binary came out byte for byte the same; UseSystemResourceKeys=true saved
        nothing and would turn the system's error messages, which answers pass on to the model, into resource keys;
        DebuggerSupport=false changed nothing measurable. Culture data instead of InvariantGlobalization cost 11 MB
        resident and 216 KB of binary, for a server that compares and formats everything invariantly.
    -->

    <!-- Published with -p:SnailMcpInstall=true, the hook forwarder beside it. -->
    <PropertyGroup>
        <!-- A hook with nothing on its input answers at once: the warm-up takes no census. -->
        <SnailMcpWarmUp>hook</SnailMcpWarmUp>
    </PropertyGroup>

    <ItemGroup>
        <SnailMcpCompanion Include="..\Hook\Snail.MCP.CleanUp.Hook.csproj"/>
    </ItemGroup>

    <PropertyGroup>
        <Version>0.1.0</Version>
        <Description>Local MCP server that keeps account of what AI agents leave behind on a Mac — processes, ports, temporary files, Docker objects, iOS simulators, Android emulators, editor state — and removes what is proven theirs, reporting everything it cannot prove.</Description>
        <PackageTags>mcp;mcp-server;modelcontextprotocol;ai;claude;cleanup;simulator;emulator;dotnet-tool</PackageTags>
        <PackageProjectUrl>https://github.com/orldev/Snail.MCP.CleanUp</PackageProjectUrl>
        <RepositoryUrl>https://github.com/orldev/Snail.MCP.CleanUp</RepositoryUrl>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Data.Sqlite"/>
        <PackageReference Include="Microsoft.Extensions.Hosting"/>
        <PackageReference Include="ModelContextProtocol"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Core\Snail.MCP.CleanUp.Core.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Snail.MCP.CleanUp.Tests"/>
        <InternalsVisibleTo Include="Snail.MCP.CleanUp.Benchmarks"/>
    </ItemGroup>

</Project>
