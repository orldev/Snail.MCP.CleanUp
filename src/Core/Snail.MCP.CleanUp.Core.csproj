<Project Sdk="Snail.Sdk">

    <PropertyGroup>
        <RootNamespace>Snail.MCP.CleanUp.Core</RootNamespace>
        <InvariantGlobalization>true</InvariantGlobalization>
        <IsAotCompatible>true</IsAotCompatible>
        <PackageId>Snail.MCP.CleanUp.Core</PackageId>
        <Version>0.1.0</Version>
        <Description>The part of cleaning up after AI agents that does not depend on where it runs: who owns what and how that is known, what a cleanup may remove, and in which order. No dependencies; the places resources live in are adapters of the host.</Description>
        <PackageTags>ai;agents;cleanup;ownership</PackageTags>
        <RepositoryUrl>https://github.com/orldev/Snail.MCP.CleanUp</RepositoryUrl>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Snail.MCP.CleanUp.Tests"/>
        <InternalsVisibleTo Include="Snail.MCP.CleanUp.Benchmarks"/>
    </ItemGroup>

</Project>
