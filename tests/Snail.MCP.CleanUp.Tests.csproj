<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <IsPackable>false</IsPackable>
        <RootNamespace>Snail.MCP.CleanUp.Tests</RootNamespace>
        <!-- A test is named by the sentence it asserts, not documented; only the server's members owe a summary. -->
        <NoWarn>$(NoWarn);CS1591</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing"/>
        <PackageReference Include="Microsoft.NET.Test.Sdk"/>
        <PackageReference Include="ModelContextProtocol"/>
        <PackageReference Include="xunit"/>
        <PackageReference Include="xunit.runner.visualstudio">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\src\Server\Snail.MCP.CleanUp.csproj"/>
        <ProjectReference Include="..\src\Hook\Snail.MCP.CleanUp.Hook.csproj"/>
    </ItemGroup>

</Project>
